# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ==================================================
# CONFIGURAÇÕES PERSONALIZADAS - CACHE E PERFORMANCE
# ==================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Versionamento automático de assets (remove o timestamp na requisição)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.+)\.(\d+)\.(js|css|png|jpg|jpeg|gif|webp|svg|woff2)$ $1.$3 [L]
</IfModule>

<IfModule mod_headers.c>
    # Configuração dinâmica baseada em ambiente
    SetEnvIf Host ^(localhost|dev\.) DEVELOPMENT_MODE=1
    
    # Desativa cache COMPLETO em desenvolvimento
    Header set Cache-Control "no-cache, no-store, must-revalidate" env=DEVELOPMENT_MODE
    Header set Pragma "no-cache" env=DEVELOPMENT_MODE
    Header set Expires 0 env=DEVELOPMENT_MODE
    
    # Cache agressivo em produção para arquivos versionados
    Header set Cache-Control "public, max-age=31536000, immutable" env=!DEVELOPMENT_MODE
    
    # Força recarregamento para HTML/PHP
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Proteção básica de arquivos
<FilesMatch "\.(env|log|htaccess|htpasswd|ini|psd|sh|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Versionamento automático para HTML estático
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|webp|svg)$ [NC]
    RewriteCond %{QUERY_STRING} !v=
    RewriteRule ^(.*)$ $1?v=%{TIME} [L]
</IfModule>